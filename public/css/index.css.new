      /* ══════════════════════════════
         NAV
      ══════════════════════════════ */
      header {
        position: sticky;
        top: 0px;
        z-index: 200;
        background: #fff;
        border-bottom: 1px solid var(--border);
      }

      nav {
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        gap: 8px;
      }

      .logo-search { display: flex; align-items: center; gap: 10px; }
      .logo { height: 30px; width: auto; }

      .search-box {
        display: none;
        align-items: center;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 6px 10px;
        gap: 8px;
        transition: border-color 0.2s;
      }
      .search-box:focus-within { border-color: var(--orange); }
      .search-box input { border: none; font-size: 13px; width: 200px; background: transparent; }
      .search-box input::placeholder { color: #aaa; }
      .search-icon { width: 16px; height: 16px; color: #aaa; flex-shrink: 0; cursor: pointer; }

      .search-menu-box { display: none; }
      .search-menu-box ul { display: flex; align-items: center; gap: 4px; }
      .search-menu-box ul > li {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 13px;
        font-weight: 500;
        position: relative;
        padding: 6px 8px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
      }
      .search-menu-box ul > li:hover { background: var(--gray); }
      .search-menu-box ul > li > a { color: #222; }

      .chevron { width: 13px; height: 13px; color: #888; transition: transform 0.25s ease, color 0.2s; flex-shrink: 0; }
      .chevron.open { transform: rotate(180deg); color: var(--orange); }

      .order-dropdown { position: relative; }
      .order-container {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        padding: 6px 0;
        min-width: 180px;
        z-index: 300;
      }
      .order-container.open { display: block; }
      .order-container ul { flex-direction: column; gap: 0; }
      .order-container ul li {
        padding: 9px 18px;
        font-size: 13px;
        cursor: pointer;
        color: #333;
        transition: background 0.15s, color 0.15s;
        white-space: nowrap;
      }
      .order-container ul li:hover { background: #fff8f2; color: var(--orange); }

      .nav-drop-buttons { display: flex; align-items: center; }
      .icons-box { display: flex; align-items: center; gap: 2px;}
      .icons-box a, .hamburger {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        color: #444;
        transition: background 0.15s, color 0.15s;
        cursor: pointer;
      }
      .icons-box a:hover, .hamburger:hover { background: var(--gray); color: var(--orange); }
      .nav-icon { width: 18px; height: 18px; }

      .wishlist a {
        width: auto;
        padding: 0 8px;
        gap: 4px;
        font-size: 12px;
        font-weight: 500;
        border: 1.5px solid var(--border);
        border-radius: 8px;
      }
      .wishlist a:hover { border-color: var(--orange); background: #fff8f2; }

      .user-menu { position: relative; }

      .user-chip {
        display: flex;
        align-items: center;
        gap: 4px;
        height: 34px;
        padding: 0 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--brown);
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
        font-family: inherit;
        transition: border-color 0.15s, background 0.15s;
        max-width: 110px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .user-chip:hover { border-color: var(--orange); background: #fff8f2; }
      .user-chip .nav-icon { width: 16px; height: 16px; flex-shrink: 0; }

      .chevron-icon {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
        stroke: var(--text-muted);
        transition: transform 0.2s;
      }
      .user-chip[aria-expanded="true"] .chevron-icon { transform: rotate(180deg); }

      .user-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 170px;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(62, 44, 35, 0.15);
        padding: 6px;
        z-index: 300;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
      }
      .user-dropdown.open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .dropdown-item {
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 9px 10px;
        border-radius: 8px;
        border: none;
        background: none;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--brown);
        cursor: pointer;
        text-align: left;
        transition: background 0.15s, color 0.15s;
      }
      .dropdown-item svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .dropdown-item:hover { background: #fef5f5; color: #e74c3c; }

      @media (max-width: 480px) {
        .user-chip {
          width: 34px;
          max-width: 34px;
          padding: 0;
          justify-content: center;
          gap: 0;
        }
        .user-chip .account,
        .user-chip .chevron-icon { display: none; }
        .wishlist a span { display: none; }
        .wishlist a { padding: 0 8px; }
        .user-dropdown {
          right: 0;
          min-width: 190px;
          padding: 6px;
        }
        .dropdown-item {
          padding: 11px 12px;
          font-size: 0.88rem;
        }
      }

      .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(30, 20, 14, 0.55);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
      }
      .modal-overlay.active {
        opacity: 1;
        visibility: visible;
      }
      .modal-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(62, 44, 35, 0.25);
        padding: 28px 22px;
        width: 100%;
        max-width: 340px;
        text-align: center;
        transform: translateY(16px) scale(0.97);
        transition: transform 0.2s ease;
      }
      .modal-overlay.active .modal-card {
        transform: translateY(0) scale(1);
      }
      .modal-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 14px;
        border-radius: 50%;
        background: #fef5f5;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .modal-icon svg {
        width: 26px;
        height: 26px;
        stroke: #e74c3c;
      }
      .modal-icon.success { background: #eafaf1; }
      .modal-icon.success svg { stroke: #27ae60; }
      .modal-card h3 {
        font-size: 1.05rem;
        color: var(--brown);
        margin-bottom: 6px;
      }
      .modal-card p {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 22px;
      }
      .modal-actions {
        display: flex;
        gap: 8px;
      }
      .modal-btn {
        flex: 1;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }
      .modal-btn.cancel {
        background: var(--gray);
        color: var(--brown);
        border: 1.5px solid var(--border);
      }
      .modal-btn.cancel:hover { background: #ececec; }
      .modal-btn.confirm {
        background: #e74c3c;
        color: #fff;
        box-shadow: 0 4px 14px rgba(231, 76, 60, 0.35);
      }
      .modal-btn.confirm:hover { background: #c0392b; }
      .modal-btn.loading { pointer-events: none; opacity: 0.8; }
      .modal-btn .btn-spinner {
        display: none;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: btn-roll 0.7s linear infinite;
      }
      .modal-btn.confirm.loading .btn-spinner { display: inline-block; }
      @keyframes btn-roll {
        to { transform: rotate(360deg); }
      }

      .hamburger { display: flex; }

      .dropdown-container {
        display: none;
        position: absolute;
        top: var(--nav-h);
        right: 8px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        width: 220px;
        padding: 10px;
        z-index: 300;
      }
      .dropdown-container.open { display: block; }
      .menu { display: flex; flex-direction: column; gap: 2px; }
      .link-icon {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 500;
        color: #333;
        transition: background 0.15s, color 0.15s;
      }
      .link-icon svg { width: 17px; height: 17px; flex-shrink: 0; }
      .link-icon:hover { background: #fff8f2; color: var(--orange);}

      .search-product {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--border);
        border-radius: 7px;
        padding: 6px 10px;
        gap: 6px;
        margin-top: 10px;
        width: 198px;
      }
      .search-product input { border: none; font-size: 13px; flex: 1; background: transparent; }
      .search-product svg { width: 15px; height: 15px; color: #aaa; flex-shrink: 0; }
      .search-product:focus-within { border-color: var(--orange); }

      .nav-divider {
        width: 1px;
        height: 18px;
        background: var(--border);
        margin: 0 4px;
      }

      /* HERO */
      .hero {
        min-height: 280px;
        background-image: url("./../images/images.jpg");
        background-size: cover;
        background-position: center;
        background-color: rgba(62, 44, 35, 0.85);
        background-blend-mode: multiply;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 32px 16px;
      }

      .hero-inner { max-width: 600px; }

      .hero-badge {
        display: inline-block;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 20px;
        margin-bottom: 14px;
      }

      .hero h1 {
        font-size: clamp(1.6rem, 6vw, 2.6rem);
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
        line-height: 1.15;
      }

      .hero h1 span { color: var(--orange-light); }

      .hero p {
        color: rgba(255,255,255,0.85);
        font-size: 13px;
        margin-bottom: 22px;
        line-height: 1.7;
      }

      .hero-buttons { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

      .btn-primary {
        background: var(--orange);
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s, transform 0.15s;
      }
      .btn-primary:hover { background: #b8660f; transform: translateY(-1px); }
      .btn-primary a { color: #fff; }

      .btn-outline {
        background: transparent;
        color: #fff;
        border: 1.5px solid rgba(255,255,255,0.5);
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s, border-color 0.2s;
      }
      .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #fff; }
      .btn-outline a { color: #fff; }

      /* SECTIONS */
      .section { padding: 28px 16px; }
      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        gap: 12px;
      }
      .section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1a1a;
        position: relative;
        padding-left: 10px;
      }
      .section-title::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 70%;
        background: var(--orange);
        border-radius: 2px;
      }
      .see-all {
        font-size: 12px;
        font-weight: 600;
        color: var(--orange);
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
      }
      .see-all:hover { text-decoration: underline; }

      /* BROWSE BY CATEGORY */
      .browse-section { padding: 28px 16px; }
      .browse-header { margin-bottom: 16px; }
      .browse-title { font-size: 1.15rem; font-weight: 700; color: #1a1a1a; margin-bottom: 4px; }
      .browse-subtitle { font-size: 12px; color: var(--text-muted); }

      .carousel-container { position: relative; display: flex; align-items: center; }
      .carousel-track {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 4px 2px;
        flex: 1;
        touch-action: pan-x;
      }
      .carousel-track::-webkit-scrollbar { display: none; }

      .carousel-container .carousel-btn {
        position: absolute;
        z-index: 10;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid var(--border);
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }
      .carousel-container .carousel-btn svg { width: 16px; height: 16px; }
      .carousel-container .carousel-btn-left { left: -4px; }
      .carousel-container .carousel-btn-right { right: -4px; }

      .carousel-item { 
        flex-shrink: 0; 
        text-align: center; 
        cursor: pointer;
        text-decoration: none;
        color: inherit;
      }
      .carousel-image {
        width: 82px;
        height: 82px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid transparent;
        transition: border-color 0.2s, transform 0.2s;
        display: block;
      }
      .carousel-item:hover .carousel-image { border-color: var(--orange); transform: translateY(-2px); }
      .image-content { 
        margin-top: 6px; 
        font-size: 10.5px; 
        font-weight: 500; 
        color: #444;
        max-width: 82px;
        word-break: break-word;
        line-height: 1.3;
      }

      /* CAROUSEL CONTROLS */
      .carousel-outer {
        position: relative;
        touch-action: pan-y;
        cursor: grab;
      }
      .carousel-outer.dragging { cursor: grabbing; scroll-behavior: auto; }

      .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 5;
        display: none;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid var(--border);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
        color: var(--brown);
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
      }
      .carousel-outer:hover .carousel-btn { display: flex; }
      .carousel-btn:hover {
        background: var(--orange);
        color: #fff;
        border-color: var(--orange);
      }
      .carousel-btn:disabled { opacity: 0.3; pointer-events: none; }
      .carousel-btn-left { left: 6px; }
      .carousel-btn-right { right: 6px; }

      /* VENDOR CARDS */
      .carousel-card {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding-bottom: 4px;
        touch-action: pan-x;
      }
      .carousel-card::-webkit-scrollbar { display: none; }

      .carousel-card-items {
        flex-shrink: 0;
        width: 190px;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition: box-shadow 0.2s, transform 0.2s;
        background: #fff;
      }
      .carousel-card-items:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }

      .carousel-card-image { width: 100%; height: 140px; object-fit: cover; display: block; }

      .card-image-content { padding: 10px; display: flex; flex-direction: column; gap: 3px; }
      .image-tittle { font-size: 13px; font-weight: 600; color: #1a1a1a; }
      .image-text-shop { font-size: 11px; color: var(--text-muted); }
      .image-text-second {
        font-size: 11px;
        color: #000;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .image-text-second::before { content: '✓'; }

      .card-button {
        background: var(--brown);
        color: #fff;
        height: 32px;
        width: 100%;
        border-radius: 7px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.4px;
        margin-top: 6px;
        transition: background 0.2s;
        cursor: pointer;
      }
      .card-button:hover { background: var(--orange); }

      /* MARKET CARDS */
      .carousel-market-card {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding-bottom: 4px;
        touch-action: pan-x;
      }
      .carousel-market-card::-webkit-scrollbar { display: none; }

      .carousel-market-card-items {
        flex-shrink: 0;
        width: 190px;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        transition: box-shadow 0.2s, transform 0.2s;
      }
      .carousel-market-card-items:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }
      .carousel-market-card-image { width: 100%; height: 140px; object-fit: cover; display: block; }

      .market-card-image-content { padding: 10px; display: flex; flex-direction: column; gap: 3px; }
      .market-image-tittle { font-size: 13px; font-weight: 600; }
      .market-image-text-shop { font-size: 11px; color: var(--text-muted); }
      .market-image-text-price { font-size: 11px; color: #2a9d5c; font-weight: 500; }
      .market-image-text-price::before { content: '✓ '; }

      .market-card-button {
        background: var(--brown);
        color: #fff;
        height: 32px;
        width: 100%;
        border-radius: 7px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.4px;
        margin-top: 6px;
        transition: background 0.2s;
        cursor: pointer;
      }
      .market-card-button:hover { background: var(--orange); }

      /* NEWSLETTER */
      .newsletter-section {
        background: linear-gradient(135deg, var(--brown) 0%, #5c3d2e 100%);
        padding: 36px 16px;
        text-align: center;
        margin: 32px 0 0;
      }
      .newsletter-section h2 { color: #fff; font-size: 1.25rem; margin-bottom: 6px; }
      .newsletter-section p { color: rgba(255,255,255,0.75); font-size: 12.5px; margin-bottom: 18px; }

      .newsletter-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 380px;
        margin: 0 auto;
      }
      .newsletter-input {
        height: 40px;
        border: 1.5px solid rgba(255,255,255,0.2);
        border-radius: 8px;
        padding: 0 14px;
        background: rgba(255,255,255,0.08);
        color: #fff;
        font-size: 13px;
      }
      .newsletter-input::placeholder { color: rgba(255,255,255,0.5); }
      .newsletter-input:focus { border-color: var(--orange-light); }
      .newsletter-btn {
        height: 40px;
        padding: 0 22px;
        background: var(--orange);
        color: #fff;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }
      .newsletter-btn:hover { background: #b8660f; }

      /* FOOTER */
      footer {
        background: #1a1109;
        color: rgba(255,255,255,0.75);
        padding: 36px 16px 20px;
      }

      .footer-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin: 0 auto 28px;
      }

      .footer-col { flex: 1 1 140px; min-width: 130px; }
      .footer-col h4 {
        color: #fff;
        font-size: 12.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 12px;
      }
      .footer-col ul li { margin-bottom: 8px; }
      .footer-col ul li a {
        font-size: 12.5px;
        color: rgba(255,255,255,0.65);
      }
      .footer-col ul li a:hover { color: var(--orange-light); }
      .footer-col ul li span {
        font-size: 11.5px;
        color: rgba(255,255,255,0.55);
        line-height: 1.6;
        display: block;
      }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.08);
        padding-top: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        text-align: center;
      }
      .footer-bottom p { font-size: 11.5px; color: rgba(255,255,255,0.4); }

      /* DESKTOP */
      @media (min-width: 640px) {
        nav { padding: 0 16px; gap: 12px; }
        .hero { padding: 40px 20px; min-height: 320px; }
        .section { padding: 36px 24px; }
        .browse-section { padding: 36px 24px; }
        .carousel-image { width: 100px; height: 100px; }
        .image-content { max-width: 100px; font-size: 11.5px; }
        .carousel-card-items, .carousel-market-card-items { width: 210px; }
        .carousel-card-image, .carousel-market-card-image { height: 160px; }
        .newsletter-form { flex-direction: row; }
        .newsletter-input { flex: 1; }
      }

      @media (min-width: 800px) {
        nav { padding: 0 24px; }
        .search-box { display: flex; }
        .search-menu-box { display: flex; align-items: center; }
        .hamburger { display: none; }
        .dropdown-container { display: none !important; }
        .icons-box { gap: 6px; }
        .hero { min-height: 380px; }
        .hero h1 { font-size: clamp(2rem, 4vw, 3rem); }
        .section { padding: 42px 32px; }
        .browse-section { padding: 42px 32px; }
        .browse-title { font-size: 1.35rem; }
        .carousel-image { width: 115px; height: 115px; }
        .image-content { max-width: 115px; font-size: 12px; }
        .carousel-card-items, .carousel-market-card-items { width: 240px; }
        .carousel-card-image, .carousel-market-card-image { height: 180px; }
        .carousel-btn { display: flex; }
        .carousel-container .carousel-btn { display: flex; }
        .footer-bottom { flex-direction: row; justify-content: space-between; text-align: left; }
      }

      @media (min-width: 1100px) {
        nav { padding: 0 40px; }
        .section { padding: 48px 40px; }
        .browse-section { padding: 48px 40px; }
        .hero { min-height: 420px; }
        .carousel-image { width: 120px; height: 120px; }
        .image-content { max-width: 120px; }
        .carousel-card-items, .carousel-market-card-items { width: 260px; }
        .carousel-card-image, .carousel-market-card-image { height: 200px; }
      }

      /* FEATURED PRODUCTS */
      .featured-products { padding-bottom: 12px; }
      .featured-products .market-image-text-price::before { content: ''; }
      .featured-products .market-image-text-price {
        color: var(--orange, #d97706);
        font-size: 13px;
        font-weight: 700;
      }
      .featured-products .market-image-text-price del { color: #aaa; font-size: 11px; font-weight: 500; }
      .featured-products .market-card-button {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }
